<?xml version="1.0" encoding="utf-8"?>
<!-- AbrirClaude - Copilot key -> Claude Quick Entry | Author / Autor: Sr.LeCuack -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">
  <Identity Name="AbrirClaude.TeclaCopilot" Publisher="CN=AbrirClaude" Version="1.2.0.0" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>Abrir Claude</DisplayName>
    <PublisherDisplayName>Sr.LeCuack</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="es-mx" />
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="AbrirClaude.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Abrir Claude" Description="Copilot key opens Claude Quick Entry / La tecla Copilot abre la consulta rapida de Claude"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.copilotkeyprovider" Id="App" DisplayName="Claude (consulta rapida)" Description="Claude Quick Entry" PublicFolder="Public" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
